// Portfolio analytics. Client generated to src/generated/prisma (Prisma 7
// `prisma-client` generator); the connection goes through a pg driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One thing a visitor did. No cookie and no address is stored: `visitor` is a
/// hash that changes every day, so a person cannot be followed across days.
model Event {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  /// pageview | section | scroll | cta | lead | hero_next | hero_play | outbound
  name      String
  path      String
  /// Which homepage hero the visitor was on, when the event happened there.
  hero      String?
  visitor   String
  /// utm_source, or the referring site's host, or null for direct visits.
  source    String?
  country   String?
  /// Present only when Cloudflare sends visitor-location headers.
  city      String?
  /// desktop | mobile | tablet
  device    String?
  browser   String?
  os        String?
  props     Json?

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([visitor, createdAt])
}

/// One person's answers to a form served under /forms/<slug>, one row per
/// browser. The page autosaves a draft while they type; pressing send stamps
/// `sentAt`. Later edits or sends update the same row.
model FormResponse {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slug       String
  /// Random id kept in the respondent's browser; not tied to who they are.
  respondent String
  /// [{ q, a }] in the order the form asks them (jsonb would reorder an object).
  answers    Json
  /// The plain-text copy the form built, when it built one.
  summary    String?
  /// When they last pressed send; null while it is only an autosaved draft.
  sentAt     DateTime?
  /// How many times this browser pressed send.
  sends      Int      @default(0)
  country    String?
  city       String?
  device     String?
  browser    String?
  os         String?

  @@unique([slug, respondent])
  @@index([slug, updatedAt])
}
